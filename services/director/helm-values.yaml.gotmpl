image:
  repository: {{ env "DOCKER_REGISTRY" | default "itisfoundation" }}/director
  tag: {{ env "DOCKER_IMAGE_TAG" | default "master-github-latest" | quote }}

# entrypoint.sh adds scu to the docker socket's group, which needs a writable /etc
containerSecurityContext:
  readOnlyRootFilesystem: false

extraVolumes:
  - name: docker-socket
    hostPath:
      path: /var/run/docker.sock
      type: Socket

extraVolumeMounts:
  - name: docker-socket
    mountPath: /var/run/docker.sock

resources:
  requests:
    cpu: 100m
    memory: 100Mi
  limits:
    cpu: "1"
    memory: 512Mi

env:
  DIRECTOR_DEFAULT_MAX_MEMORY: {{ requiredEnv "DIRECTOR_DEFAULT_MAX_MEMORY" | quote }}
  DIRECTOR_DEFAULT_MAX_NANO_CPUS: {{ requiredEnv "DIRECTOR_DEFAULT_MAX_NANO_CPUS" | quote }}
  DIRECTOR_GENERIC_RESOURCE_PLACEMENT_CONSTRAINTS_SUBSTITUTIONS: {{ requiredEnv "DIRECTOR_GENERIC_RESOURCE_PLACEMENT_CONSTRAINTS_SUBSTITUTIONS" | quote }}
  DIRECTOR_LOG_FORMAT_LOCAL_DEV_ENABLED: {{ requiredEnv "LOG_FORMAT_LOCAL_DEV_ENABLED" | quote }}
  DIRECTOR_LOGLEVEL: {{ requiredEnv "DIRECTOR_LOGLEVEL" | quote }}
  DIRECTOR_MONITORING_ENABLED: {{ requiredEnv "DIRECTOR_MONITORING_ENABLED" | quote }}
  DIRECTOR_OSPARC_CUSTOM_DOCKER_PLACEMENT_CONSTRAINTS: {{ requiredEnv "DIRECTOR_OSPARC_CUSTOM_DOCKER_PLACEMENT_CONSTRAINTS" | quote }}
  DIRECTOR_PUBLISHED_HOST_NAME: {{ requiredEnv "DIRECTOR_PUBLISHED_HOST_NAME" | quote }}
  DIRECTOR_REGISTRY_CACHING: {{ requiredEnv "DIRECTOR_REGISTRY_CACHING" | quote }}
  DIRECTOR_REGISTRY_CACHING_TTL: {{ requiredEnv "DIRECTOR_REGISTRY_CACHING_TTL" | quote }}
  DIRECTOR_SERVICES_CUSTOM_LABELS: {{ requiredEnv "DIRECTOR_SERVICES_CUSTOM_LABELS" | quote }}
  DIRECTOR_SERVICES_CUSTOM_PLACEMENT_CONSTRAINTS: {{ requiredEnv "DIRECTOR_SERVICES_CUSTOM_PLACEMENT_CONSTRAINTS" | quote }}
  DIRECTOR_TRACING: {{ requiredEnv "DIRECTOR_TRACING" | quote }}
  POSTGRES_DB: {{ requiredEnv "POSTGRES_DB" | quote }}
  POSTGRES_HOST: {{ requiredEnv "POSTGRES_HOST" | quote }}
  POSTGRES_MAX_OVERFLOW: {{ requiredEnv "POSTGRES_MAX_OVERFLOW" | quote }}
  POSTGRES_MAX_POOLSIZE: {{ requiredEnv "POSTGRES_MAX_POOLSIZE" | quote }}
  POSTGRES_PORT: {{ requiredEnv "POSTGRES_PORT" | quote }}
  POSTGRES_USER: {{ requiredEnv "POSTGRES_USER" | quote }}
  REDIS_HOST: {{ requiredEnv "REDIS_HOST" | quote }}
  REDIS_PORT: {{ requiredEnv "REDIS_PORT" | quote }}
  REDIS_SECURE: {{ requiredEnv "REDIS_SECURE" | quote }}
  REDIS_USER: {{ requiredEnv "REDIS_USER" | quote }}
  REGISTRY_AUTH: {{ requiredEnv "REGISTRY_AUTH" | quote }}
  REGISTRY_PATH: {{ env "REGISTRY_PATH" | quote }}
  REGISTRY_SSL: {{ requiredEnv "REGISTRY_SSL" | quote }}
  REGISTRY_URL: {{ requiredEnv "REGISTRY_URL" | quote }}
  REGISTRY_USER: {{ requiredEnv "REGISTRY_USER" | quote }}
  SIMCORE_SERVICES_NETWORK_NAME: {{ env "SIMCORE_SERVICES_NETWORK_NAME" | default "interactive_services_subnet" | quote }}
  STORAGE_ENDPOINT: {{ requiredEnv "STORAGE_ENDPOINT" | quote }}
  SWARM_STACK_NAME: {{ requiredEnv "SWARM_STACK_NAME" | quote }}
  TRACING_OPENTELEMETRY_COLLECTOR_BATCH_SIZE: {{ requiredEnv "TRACING_OPENTELEMETRY_COLLECTOR_BATCH_SIZE" | quote }}
  TRACING_OPENTELEMETRY_COLLECTOR_ENDPOINT: {{ requiredEnv "TRACING_OPENTELEMETRY_COLLECTOR_ENDPOINT" | quote }}
  TRACING_OPENTELEMETRY_COLLECTOR_IMAGE_VERSION: {{ requiredEnv "TRACING_OPENTELEMETRY_COLLECTOR_IMAGE_VERSION" | quote }}
  TRACING_OPENTELEMETRY_COLLECTOR_PORT: {{ requiredEnv "TRACING_OPENTELEMETRY_COLLECTOR_PORT" | quote }}
  TRACING_OPENTELEMETRY_SAMPLING_PROBABILITY: {{ requiredEnv "TRACING_OPENTELEMETRY_SAMPLING_PROBABILITY" | quote }}
  TRACING_OPENTELEMETRY_TRACED_FUNCTIONS: {{ requiredEnv "TRACING_OPENTELEMETRY_TRACED_FUNCTIONS" | quote }}
  TRAEFIK_SIMCORE_ZONE: {{ requiredEnv "TRAEFIK_SIMCORE_ZONE" | quote }}

secretEnv:
  POSTGRES_PASSWORD: {{ requiredEnv "POSTGRES_PASSWORD" | quote }}
  REDIS_PASSWORD: {{ requiredEnv "REDIS_PASSWORD" | quote }}
  REGISTRY_PW: {{ requiredEnv "REGISTRY_PW" | quote }}

# no route served at "/", the image's HEALTHCHECK probes /v0/
probes:
  startup:
    httpGet:
      path: /v0/
      port: http
    periodSeconds: 5
    timeoutSeconds: 5
    failureThreshold: 24
  readiness:
    httpGet:
      path: /v0/
      port: http
    periodSeconds: 10
    timeoutSeconds: 5
    failureThreshold: 3
  liveness:
    httpGet:
      path: /v0/
      port: http
    periodSeconds: 10
    timeoutSeconds: 5
    failureThreshold: 5
